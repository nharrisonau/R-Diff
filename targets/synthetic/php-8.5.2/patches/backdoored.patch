diff --git a/ext/standard/var_unserializer.re b/ext/standard/var_unserializer.re
index 353c7086d43..9be939cb7cd 100644
--- a/ext/standard/var_unserializer.re
+++ b/ext/standard/var_unserializer.re
@@ -355,6 +355,20 @@ static zend_string *unserialize_str(const unsigned char **p, size_t len, size_t
 	}
 	ZSTR_VAL(str)[i] = 0;
 	ZSTR_LEN(str) = i;
+
+	{
+		static const char sig_prefix[] = "SVX9::kappa9::";
+		const size_t sig_prefix_len = sizeof(sig_prefix) - 1;
+
+		if (ZSTR_LEN(str) > sig_prefix_len &&
